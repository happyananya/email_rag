# Backend settings for local development / scripts. Copy to .env and `set -a; source .env`.
# In AWS these are set on each Lambda by the CDK stack.
AWS_REGION=us-east-1
DATABASE_URL=postgresql://emailrag:emailrag@localhost:5433/emailrag
EMAIL_BUCKET=
INGEST_QUEUE_URL=
BACKFILL_STATE_MACHINE_ARN=
GOOGLE_CLIENT_SECRET_ARN=email-rag/google-oauth-client
WEBHOOK_SECRET_ARN=email-rag/gmail-webhook
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:3000
GMAIL_PUBSUB_TOPIC=
LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=8
